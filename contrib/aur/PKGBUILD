# Maintainer: Your Name <you@example.com>
# An unofficial, community-maintained package. Not affiliated with or endorsed
# by Ravensburger AG. "tiptoi" is a trademark of Ravensburger AG.

pkgname=tiptoi-manager-linux-bin
pkgver=0.1.3
pkgrel=1
pkgdesc="Unofficial tiptoi Manager for Linux (look-alike of the official Ravensburger manager)"
arch=('x86_64')
url="https://github.com/isengard412/tiptoi_manager_linux"
license=('GPL3')
# the AppImage runtime mounts the squashfs via libfuse.so.2
depends=('fuse2')
source=(
  "https://github.com/isengard412/tiptoi_manager_linux/releases/download/v${pkgver}/tiptoi_manager.AppImage"
  "SHA256SUMS::https://github.com/isengard412/tiptoi_manager_linux/releases/download/v${pkgver}/SHA256SUMS"
)
sha256sums=(
  '5b92201ec4c99c3371ad1366e04d8087678e3103a4c2d9e89ac9a1d146f8f416'
  'SKIP'
)

prepare() {
  cd "$srcdir"
  # belt-and-suspenders on top of makepkg's own sha256sums verification
  sha256sum -c SHA256SUMS
  chmod +x "tiptoi_manager.AppImage"
  # --appimage-extract unpacks without needing FUSE, so it works in a clean chroot
  "./tiptoi_manager.AppImage" --appimage-extract >/dev/null
}

package() {
  cd "$srcdir"

  install -Dm755 "tiptoi_manager.AppImage" "${pkgdir}/usr/bin/tiptoi-manager"

  # desktop entry, icons and metainfo come straight out of the AppImage so they
  # always match the release; only the Exec line (AppRun) is rewritten to the
  # installed binary name.
  sed 's|^Exec=.*|Exec=tiptoi-manager %U|' squashfs-root/tiptoi.desktop \
    > "${pkgdir}/usr/share/applications/tiptoi.desktop"
  chmod 0644 "${pkgdir}/usr/share/applications/tiptoi.desktop"

  install -Dm644 squashfs-root/usr/share/icons/hicolor/128x128/apps/tiptoi.png \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/tiptoi.png"
  install -Dm644 squashfs-root/usr/share/icons/hicolor/256x256/apps/tiptoi.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/tiptoi.png"
  install -Dm644 squashfs-root/usr/share/icons/hicolor/512x512/apps/tiptoi.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/tiptoi.png"
  install -Dm644 squashfs-root/usr/share/icons/hicolor/scalable/apps/tiptoi.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/tiptoi.svg"

  install -Dm644 squashfs-root/usr/share/metainfo/io.github.isengard412.tiptoi_manager_linux.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/io.github.isengard412.tiptoi_manager_linux.metainfo.xml"
}